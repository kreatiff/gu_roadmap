# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Google OAuth 2.0 / OpenID Connect ─────────────────────────────────────────
# Leave OIDC_ISSUER empty to use the dev-login bypass instead of real Google auth.
#
# To enable Google auth:
#   1. Go to https://console.cloud.google.com and create (or select) a project
#   2. APIs & Services → OAuth consent screen → choose "Internal" (Workspace users only)
#      Add scopes: openid, email, profile
#   3. APIs & Services → Credentials → Create Credentials → OAuth client ID
#      Application type: Web application
#      Authorised redirect URIs:
#        - http://localhost:3001/api/auth/callback    (local dev)
#        - https://vle.1pod.top/api/auth/callback     (production)
#   4. Copy the Client ID and Client Secret below
#   5. The OIDC_ISSUER for Google is always: https://accounts.google.com
#
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
OIDC_CLIENT_SECRET=<your-google-client-secret>
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# DANGER: Only enable in local development. Provides a bypassable auth fallback.
DEV_AUTH_ENABLED=false

# ── Security ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=<generate-with-openssl-at-least-32-chars>
COOKIE_SECRET=<generate-with-openssl-at-least-32-chars>

# JWT session duration (e.g. 8h, 1d, 7d). Default 8h.
JWT_EXPIRY=8h

# ── CORS / Frontend ────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Bootstrap Admin ────────────────────────────────────────────────────────────
# Created automatically on first startup if the users database container is empty.
# Change password immediately after first login.
# BOOTSTRAP_ADMIN_PASSWORD must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@griffith.edu.au
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# ── Azure Cosmos DB ────────────────────────────────────────────────────────────
# Cosmos DB for NoSQL (document API)
# For local dev use the Cosmos DB Emulator (https://aka.ms/cosmosdb-emulator)
#   Emulator endpoint: https://localhost:8081
#   Emulator key:      C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b7u8kTMKxPh8ISbMpLrMjERHOy8vEAQ==
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=<primary-or-secondary-key>
COSMOS_DATABASE_ID=gu_roadmap

# ── Jira Integration ────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://<your-org>.atlassian.net
JIRA_EMAIL=your-email@griffith.edu.au
JIRA_API_TOKEN=<jira-api-token>
JIRA_PROJECT_KEY=VLE

# ── Azure OpenAI Completions ──────────────────────────────────────────────────
# Supports either a Project Gateway endpoint or standard Azure OpenAI resource endpoint
AI_PROJECT_ENDPOINT=https://aif-ds-arch-snd-ae.services.ai.azure.com/api/projects/proj-ds-arch-snd-ae
AI_PROJECT_API_KEY=<your-api-key>
AI_DEPLOYMENT_NAME=gpt-4o
AI_API_VERSION=2024-02-01
