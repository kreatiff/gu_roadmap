# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Microsoft Entra ID (Azure AD) OIDC ────────────────────────────────────────
# Leave OIDC_ISSUER empty to use the dev-login bypass instead of real Microsoft auth.
#
# To enable real Microsoft auth:
#   1. Register an app in Azure Portal → Entra ID → App Registrations
#   2. Add redirect URI: https://<your-domain>/api/auth/callback
#      (also add http://localhost:3001/api/auth/callback for local dev)
#   3. Under "Certificates & secrets", create a new client secret
#   4. Under "API permissions", ensure: openid, email, profile (delegated)
#   5. Fill in the values below using your Directory (tenant) ID and Application (client) ID
#
OIDC_ISSUER=https://login.microsoftonline.com/{TENANT_ID}/v2.0
OIDC_CLIENT_ID=<app-registration-client-id>
OIDC_CLIENT_SECRET=<app-registration-client-secret>
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ── Security ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change-me-to-at-least-32-characters-abc
COOKIE_SECRET=change-me-to-at-least-32-characters-xyz

# ── CORS / Frontend ────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Admin Access ───────────────────────────────────────────────────────────────
# Comma-separated list of @griffith.edu.au emails that get admin privileges
ADMIN_EMAILS=o.estrin@griffith.edu.au

# ── Azure Cosmos DB ────────────────────────────────────────────────────────────
# Cosmos DB for NoSQL (document API)
# For local dev use the Cosmos DB Emulator (https://aka.ms/cosmosdb-emulator)
#   Emulator endpoint: https://localhost:8081
#   Emulator key:      C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b7u8kTMKxPh8ISbMpLrMjERHOy8vEAQ==
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=<primary-or-secondary-key>
COSMOS_DATABASE_ID=gu_roadmap
